FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamRun;

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5;

deltaT          1;

writeControl    runTime;

writeInterval   0.01;

// purgeWrite      0;

writeFormat     ascii;

writePrecision  15;

writeCompression off;

timeFormat      general;

timePrecision   15;

runTimeModifiable true;

functions
{
    writeObjects1
    {
        type            writeObjects;
        libs            ("libutilityFunctionObjects.so");
        objects         (h rho);
        writeControl    timeStep;
        writeInterval   1;
    }
}
