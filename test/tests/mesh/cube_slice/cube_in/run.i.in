[Mesh]
  type = FoamMesh
  foam_args = '-case foaminput -parallel'
  foam_patch = ''
  dim=2
[]

[FoamVariables]
  [T]
    type = FoamVariableField
    foam_variable = T
  []
[]

[FoamBCs]
  [T]
    type = FoamFixedValueBC
    foam_variable = T
    v = T
  []
[]

[Problem]
  type = FoamProblem
  solve = false
[]

[Executioner]
  type = Transient
  start_time = 0.0
  end_time = 0.1
  dt = 0.1
  solve_type = 'PJFNK'
  petsc_options_iname = '-pc_type -pc_hypre_type'
  petsc_options_value = 'hypre boomeramg'
[../]

[Outputs]
  exodus = true
[]
