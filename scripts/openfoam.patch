+// Helper called from the delegating-constructor member-initializer list.
+// Stores the external MPI communicator via UPstream::init(void*) as a side-
+// effect before the standard argList(argc,argv,...) constructor body runs.
+// Returns argc unchanged so it can be forwarded to the delegated ctor.
+static int& storeExternalMpiComm(void* comm, bool needsThread, int& argc)
+{
+    Foam::UPstream::init(comm, needsThread);
+    return argc;
+}
+} // namespace
+
+
+// Construct from argc/argv with an externally-owned MPI communicator.
+// Intended for embedding OpenFOAM inside another MPI application (e.g. MOOSE/hippo)
+// that has already called MPI_Init. The communicator is stored via
+// storeExternalMpiComm() so that allocateCommunicatorComponents() uses it
+// instead of MPI_COMM_WORLD when the standard init(argc,argv) path runs.
+Foam::argList::argList
+(
+    int& argc,
+    char**& argv,
+    void* comm,
+    bool checkArgs,
+    bool checkOpts,
+    bool initialise
+)
+:
+    argList
+    (
+        storeExternalMpiComm(comm, argList::parallelThreads_, argc),
+        argv,
+        checkArgs,
+        checkOpts,
+        initialise
+    )
+{}
