+bool Foam::UPstream::init(void* comm_ptr, const bool needsThread)
+{
+    int flag = 0;
+
+    MPI_Initialized(&flag);
+    if (!flag)
+    {
+        FatalErrorInFunction
+            << "UPstream::init(void* comm): MPI must already be initialized "
+               "before passing an external communicator."
+            << Foam::exit(FatalError);
+        return false;
+    }
+
+    // Store the external communicator. The caller retains ownership.
+    externalMpiComm = *reinterpret_cast<MPI_Comm*>(comm_ptr);
+    ourMpi = false;  // we did not call MPI_Init
+
+    if (needsThread)
+    {
+        int provided = 0;
+        MPI_Query_thread(&provided);
+        if (provided < MPI_THREAD_MULTIPLE)
+        {
+            WarningInFunction
+                << "External MPI was not initialized with MPI_THREAD_MULTIPLE."
+                << " Thread safety may be compromised." << nl;
+        }
+    }
+
+    return true;
+}
